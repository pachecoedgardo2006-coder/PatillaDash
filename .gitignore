## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from `dotnet new gitignore`

# dotenv files
.env
.env.local
.env.*.local
*.secret
appsettings.Local.json

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.log

# Visual Studio cache
.vs/

# .NET
project.lock.json
project.fragment.lock.json
artifacts/
bin/
obj/

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage*.json
coverage*.xml
coverage*.info

# Bases de Datos Locales (SQLite / temporales de prueba)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Frontend / Node y Vite
node_modules/
dist/
.vite/

# IDEs y Editores
.vscode/
.idea/
*.sln.iml
.cr/

# Archivos de Sistema Operativo
.DS_Store
Thumbs.db
[Dd]esktop.ini

# Agentes locales
.agents/
.gemini/
