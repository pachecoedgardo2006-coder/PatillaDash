# ===================================================
# VARIABLES DE ENTORNO SUGERIDAS (NO SUBIR .env REAL A GITHUB)
# ===================================================

# 1. Base de datos (Supabase ó PostgreSQL)
# Formato URI directo o Session Pooler de Supabase:
DATABASE_URL=postgresql://postgres:[TU_CONTRASEÑA]@db.[TU_PROJECT_REF].supabase.co:5432/postgres

# 2. Seguridad JWT (Al menos 32 caracteres seguros)
JWT_SECRET_KEY=GeneraUnaClaveSuperSeguraDeMasDe32CaracteresParaProduccion2026!

# 3. CORS en Render (Permitir únicamente tu frontend en Netlify)
CORS_ALLOWED_ORIGINS=https://tu-proyecto-patilladash.netlify.app

# 4. Puerto (Render asigna esta variable automáticamente)
PORT=10000

# 5. Frontend en Netlify
VITE_API_URL=https://patilladash-api.onrender.com/api
